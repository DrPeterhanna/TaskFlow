# No defaults. Pick exactly one environment per build.
EXPO_PUBLIC_TASKFLOW_ENV=            # local | test | production
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=            # publishable key only
EXPO_PUBLIC_TEST_PROJECT_REF=        # required when env=test
EXPO_PUBLIC_ALLOW_PRODUCTION=        # must be yes-i-mean-production when env=production
